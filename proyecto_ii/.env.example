# Copia este fichero a .env y rellena el token. .env NUNCA se sube a Git.
# Token en https://huggingface.co/settings/tokens
HF_TOKEN=
# Modelo del Hub para explicar las predicciones (chat_completion)
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Nivel de log de la CLI (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
